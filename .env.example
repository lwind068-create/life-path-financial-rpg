# Copy this file to .env.local (already gitignored via *.local) and fill in
# the values from your Firebase project's web app config. See
# SETUP_FIREBASE.md for step-by-step instructions.
#
# These are NOT secret keys — Firebase web config is meant to be public;
# actual access control is enforced by firestore.rules. It's still fine to
# keep them out of git so each contributor points at their own project
# while testing.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
